{
  "name": "dictionary-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "api:fetch": "node scripts/fetch-api-docs.mjs",
    "api:types": "openapi-typescript openapi/api-docs.json -o src/api/schema.d.ts",
    "api:generate": "npm run api:fetch && npm run api:types"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@tanstack/react-query": "5.102.8",
    "antd": "6.6.4",
    "openapi-fetch": "0.17.0",
    "openapi-react-query": "0.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.3"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "5.102.8",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
