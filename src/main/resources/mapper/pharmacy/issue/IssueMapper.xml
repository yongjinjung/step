<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  불출 (phm_issue) + 불출 품목 (phm_issue_item). 불출은 수정하지 않는다.
  불출(s) → 조제(d) → 처방(p), 불출 품목(si) → 조제 품목(di) → 처방 품목(pi).
  별칭·열 이름 규칙은 PrescriptionMapper.xml 머리말 참고. 이 파일의 결과 매핑과 열 조각은 반납 매퍼도 쓴다.
-->
<mapper namespace="com.step.dictionary.pharmacy.issue.IssueMapper">

    <resultMap id="issue" type="com.step.dictionary.pharmacy.issue.Issue">
        <id property="id" column="s_id"/>
        <result property="destinationCode" column="s_destination_code"/>
        <result property="destinationName" column="s_destination_name"/>
        <result property="receiverName" column="s_receiver_name"/>
        <result property="issuedBy" column="s_issued_by"/>
        <result property="issuedAt" column="s_issued_at"/>
        <result property="remark" column="s_remark"/>
        <result property="createdAt" column="s_created_at"/>
        <result property="updatedAt" column="s_updated_at"/>
        <association property="dispensing"
                     resultMap="com.step.dictionary.pharmacy.dispensing.DispensingMapper.dispensing"/>
    </resultMap>

    <resultMap id="issueItem" type="com.step.dictionary.pharmacy.issue.IssueItem">
        <id property="id" column="si_id"/>
        <result property="quantity" column="si_quantity"/>
        <association property="dispensingItem"
                     resultMap="com.step.dictionary.pharmacy.dispensing.DispensingMapper.dispensingItem"/>
    </resultMap>

    <!-- 불출(s) + 조제(d) + 처방(p) 열. -->
    <sql id="issueColumns">
        s.id AS s_id, s.destination_code AS s_destination_code, s.destination_name AS s_destination_name,
        s.receiver_name AS s_receiver_name, s.issued_by AS s_issued_by, s.issued_at AS s_issued_at,
        s.remark AS s_remark, s.created_at AS s_created_at, s.updated_at AS s_updated_at,
        <include refid="com.step.dictionary.pharmacy.dispensing.DispensingMapper.dispensingColumns"/>
    </sql>

    <!-- 불출 품목(si) + 조제 품목(di) + 처방 품목(pi) 열. -->
    <sql id="issueItemColumns">
        si.id AS si_id, si.quantity AS si_quantity,
        <include refid="com.step.dictionary.pharmacy.dispensing.DispensingMapper.dispensingItemColumns"/>
    </sql>

    <sql id="from">
        FROM phm_issue s
        JOIN phm_dispensing d ON d.id = s.dispensing_id
        JOIN phm_prescription p ON p.id = d.prescription_id
    </sql>

    <select id="findById" resultMap="issue">
        SELECT <include refid="issueColumns"/>
        <include refid="from"/>
        WHERE s.id = #{id}
    </select>

    <select id="findItemsByIssueId" resultMap="issueItem">
        SELECT <include refid="issueItemColumns"/>
        FROM phm_issue_item si
        JOIN phm_dispensing_item di ON di.id = si.dispensing_item_id
        JOIN phm_prescription_item pi ON pi.id = di.prescription_item_id
        WHERE si.issue_id = #{issueId}
        ORDER BY si.id ASC
    </select>

    <!-- 불출처 코드는 대문자로 정확히 일치, from/to는 불출 일자(양 끝 포함). -->
    <sql id="searchWhere">
        <bind name="destinationCode" value="@com.step.dictionary.global.mybatis.SqlParams@upper(c.destinationCode)"/>
        <bind name="fromAt" value="@com.step.dictionary.global.mybatis.SqlParams@startOfDay(c.from)"/>
        <bind name="toBefore" value="@com.step.dictionary.global.mybatis.SqlParams@startOfNextDay(c.to)"/>
        <where>
            <include refid="com.step.dictionary.pharmacy.prescription.PrescriptionMapper.keywordCondition"/>
            <if test="destinationCode != null">AND s.destination_code = #{destinationCode}</if>
            <if test="fromAt != null">AND s.issued_at &gt;= #{fromAt}</if>
            <if test="toBefore != null">AND s.issued_at &lt; #{toBefore}</if>
        </where>
    </sql>

    <select id="search" resultMap="issue">
        SELECT <include refid="issueColumns"/>
        <include refid="from"/>
        <include refid="searchWhere"/>
        ORDER BY s.issued_at DESC, s.id DESC
        OFFSET #{p.offset} ROWS FETCH NEXT #{p.pageSize} ROWS ONLY
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*) <include refid="from"/>
        <include refid="searchWhere"/>
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO phm_issue (dispensing_id, destination_code, destination_name, receiver_name, issued_by, issued_at,
                               remark, created_at, updated_at)
        VALUES (#{dispensing.id}, #{destinationCode}, #{destinationName}, #{receiverName}, #{issuedBy}, #{issuedAt},
                #{remark}, #{createdAt}, #{updatedAt})
    </insert>

    <insert id="insertItem" useGeneratedKeys="true" keyProperty="item.id" keyColumn="id">
        INSERT INTO phm_issue_item (issue_id, dispensing_item_id, quantity)
        VALUES (#{issueId}, #{item.dispensingItem.id}, #{item.quantity})
    </insert>
</mapper>
