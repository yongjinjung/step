<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  조제 (phm_dispensing) + 조제 품목 (phm_dispensing_item).
  조제(d) → 처방(p), 조제 품목(di) → 처방 품목(pi). 별칭·열 이름 규칙은 PrescriptionMapper.xml 머리말 참고.
  이 파일의 결과 매핑과 열 조각은 검수·불출·반납 매퍼도 쓴다.
-->
<mapper namespace="com.step.dictionary.pharmacy.dispensing.DispensingMapper">

    <resultMap id="dispensing" type="com.step.dictionary.pharmacy.dispensing.Dispensing">
        <id property="id" column="d_id"/>
        <result property="status" column="d_status"/>
        <result property="dispensedBy" column="d_dispensed_by"/>
        <result property="dispensedAt" column="d_dispensed_at"/>
        <result property="remark" column="d_remark"/>
        <result property="createdAt" column="d_created_at"/>
        <result property="updatedAt" column="d_updated_at"/>
        <association property="prescription"
                     resultMap="com.step.dictionary.pharmacy.prescription.PrescriptionMapper.prescription"/>
    </resultMap>

    <resultMap id="dispensingItem" type="com.step.dictionary.pharmacy.dispensing.DispensingItem">
        <id property="id" column="di_id"/>
        <result property="quantity" column="di_quantity"/>
        <result property="lotNo" column="di_lot_no"/>
        <result property="expiryDate" column="di_expiry_date"/>
        <association property="prescriptionItem"
                     resultMap="com.step.dictionary.pharmacy.prescription.PrescriptionMapper.prescriptionItem"/>
    </resultMap>

    <!-- 조제(d) + 처방(p) 열. FROM 절에 phm_dispensing d, phm_prescription p가 있어야 한다. -->
    <sql id="dispensingColumns">
        d.id AS d_id, d.status AS d_status, d.dispensed_by AS d_dispensed_by, d.dispensed_at AS d_dispensed_at,
        d.remark AS d_remark, d.created_at AS d_created_at, d.updated_at AS d_updated_at,
        <include refid="com.step.dictionary.pharmacy.prescription.PrescriptionMapper.prescriptionColumns"/>
    </sql>

    <!-- 조제 품목(di) + 처방 품목(pi) 열. FROM 절에 phm_dispensing_item di, phm_prescription_item pi가 있어야 한다. -->
    <sql id="dispensingItemColumns">
        di.id AS di_id, di.quantity AS di_quantity, di.lot_no AS di_lot_no, di.expiry_date AS di_expiry_date,
        <include refid="com.step.dictionary.pharmacy.prescription.PrescriptionMapper.prescriptionItemColumns"/>
    </sql>

    <sql id="from">
        FROM phm_dispensing d
        JOIN phm_prescription p ON p.id = d.prescription_id
    </sql>

    <select id="findById" resultMap="dispensing">
        SELECT <include refid="dispensingColumns"/>
        <include refid="from"/>
        WHERE d.id = #{id}
    </select>

    <select id="findItemsByDispensingId" resultMap="dispensingItem">
        SELECT <include refid="dispensingItemColumns"/>
        FROM phm_dispensing_item di
        JOIN phm_prescription_item pi ON pi.id = di.prescription_item_id
        WHERE di.dispensing_id = #{dispensingId}
        ORDER BY di.id ASC
    </select>

    <select id="countByPrescriptionIdAndStatusNot" resultType="long">
        SELECT COUNT(*) FROM phm_dispensing WHERE prescription_id = #{prescriptionId} AND status &lt;&gt; #{status}
    </select>

    <!-- from/to는 조제 일자(양 끝 포함). -->
    <sql id="searchWhere">
        <bind name="fromAt" value="@com.step.dictionary.global.mybatis.SqlParams@startOfDay(c.from)"/>
        <bind name="toBefore" value="@com.step.dictionary.global.mybatis.SqlParams@startOfNextDay(c.to)"/>
        <where>
            <include refid="com.step.dictionary.pharmacy.prescription.PrescriptionMapper.keywordCondition"/>
            <if test="c.prescriptionId != null">AND d.prescription_id = #{c.prescriptionId}</if>
            <if test="c.status != null">AND d.status = #{c.status}</if>
            <if test="fromAt != null">AND d.dispensed_at &gt;= #{fromAt}</if>
            <if test="toBefore != null">AND d.dispensed_at &lt; #{toBefore}</if>
        </where>
    </sql>

    <select id="search" resultMap="dispensing">
        SELECT <include refid="dispensingColumns"/>
        <include refid="from"/>
        <include refid="searchWhere"/>
        ORDER BY d.dispensed_at DESC, d.id DESC
        LIMIT #{p.pageSize} OFFSET #{p.offset}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*) <include refid="from"/>
        <include refid="searchWhere"/>
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO phm_dispensing (prescription_id, status, dispensed_by, dispensed_at, remark, created_at, updated_at)
        VALUES (#{prescription.id}, #{status}, #{dispensedBy}, #{dispensedAt}, #{remark}, #{createdAt}, #{updatedAt})
    </insert>

    <insert id="insertItem" useGeneratedKeys="true" keyProperty="item.id" keyColumn="id">
        INSERT INTO phm_dispensing_item (dispensing_id, prescription_item_id, quantity, lot_no, expiry_date)
        VALUES (#{dispensingId}, #{item.prescriptionItem.id}, #{item.quantity}, #{item.lotNo}, #{item.expiryDate})
    </insert>

    <update id="updateStatus">
        UPDATE phm_dispensing SET status = #{status}, updated_at = #{updatedAt} WHERE id = #{id}
    </update>
</mapper>
