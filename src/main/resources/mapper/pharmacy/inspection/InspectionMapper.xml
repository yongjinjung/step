<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  검수 (phm_inspection) + 검수 품목 (phm_inspection_item). 검수는 수정하지 않는다.
  검수 → 조제(d_) → 처방(d_p_), 검수 품목 → 조제 품목(di_) → 처방 품목(di_pi_).
-->
<mapper namespace="com.step.dictionary.pharmacy.inspection.InspectionMapper">

    <resultMap id="inspection" type="com.step.dictionary.pharmacy.inspection.Inspection" autoMapping="true">
        <id property="id" column="id"/>
        <association property="dispensing" columnPrefix="d_"
                     resultMap="com.step.dictionary.pharmacy.dispensing.DispensingMapper.dispensing"/>
    </resultMap>

    <resultMap id="inspectionItem" type="com.step.dictionary.pharmacy.inspection.InspectionItem" autoMapping="true">
        <id property="id" column="id"/>
        <association property="dispensingItem" columnPrefix="di_"
                     resultMap="com.step.dictionary.pharmacy.dispensing.DispensingMapper.dispensingItem"/>
    </resultMap>

    <sql id="columns">
        i.id, i.result, i.inspected_by, i.inspected_at, i.remark, i.created_at, i.updated_at,
        <include refid="com.step.dictionary.pharmacy.dispensing.DispensingMapper.dispensingColumns">
            <property name="a" value="i_d"/><property name="p" value="d_"/>
        </include>
    </sql>

    <sql id="from">
        FROM phm_inspection i
        JOIN phm_dispensing i_d ON i_d.id = i.dispensing_id
        JOIN phm_prescription i_d_p ON i_d_p.id = i_d.prescription_id
    </sql>

    <select id="findById" resultMap="inspection">
        SELECT <include refid="columns"/> <include refid="from"/> WHERE i.id = #{id}
    </select>

    <select id="findItemsByInspectionId" resultMap="inspectionItem">
        SELECT ii.id, ii.result, ii.defect_reason,
        <include refid="com.step.dictionary.pharmacy.dispensing.DispensingMapper.dispensingItemColumns">
            <property name="a" value="ii_di"/><property name="p" value="di_"/>
        </include>
        FROM phm_inspection_item ii
        JOIN phm_dispensing_item ii_di ON ii_di.id = ii.dispensing_item_id
        JOIN phm_prescription_item ii_di_pi ON ii_di_pi.id = ii_di.prescription_item_id
        WHERE ii.inspection_id = #{inspectionId}
        ORDER BY ii.id ASC
    </select>

    <sql id="searchWhere">
        <where>
            <include refid="com.step.dictionary.pharmacy.prescription.PrescriptionMapper.keywordCondition">
                <property name="a" value="i_d_p"/>
            </include>
            <if test="c.result != null">AND i.result = #{c.result}</if>
            <include refid="com.step.dictionary.pharmacy.prescription.PrescriptionMapper.periodCondition">
                <property name="col" value="i.inspected_at"/>
            </include>
        </where>
    </sql>

    <select id="search" resultMap="inspection">
        SELECT <include refid="columns"/> <include refid="from"/>
        <include refid="searchWhere"/>
        ORDER BY i.inspected_at DESC, i.id DESC
        LIMIT #{p.pageSize} OFFSET #{p.offset}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*) <include refid="from"/>
        <include refid="searchWhere"/>
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO phm_inspection (dispensing_id, result, inspected_by, inspected_at, remark, created_at, updated_at)
        VALUES (#{dispensing.id}, #{result}, #{inspectedBy}, #{inspectedAt}, #{remark}, #{createdAt}, #{updatedAt})
    </insert>

    <insert id="insertItem" useGeneratedKeys="true" keyProperty="item.id" keyColumn="id">
        INSERT INTO phm_inspection_item (inspection_id, dispensing_item_id, result, defect_reason)
        VALUES (#{inspectionId}, #{item.dispensingItem.id}, #{item.result}, #{item.defectReason})
    </insert>
</mapper>
