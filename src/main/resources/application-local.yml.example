# 로컬 개발 설정 예시. 이 파일을 같은 폴더에 application-local.yml로 복사한 뒤 값을 채운다.
#   cp src/main/resources/application-local.yml.example src/main/resources/application-local.yml
# application-local.yml은 비밀값이 들어가므로 .gitignore로 커밋에서 제외한다.
# MySQL은 `docker compose up -d`로 실행한다 (접속 정보는 compose.yaml과 같다).
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/dictionary
    username: dictionary
    password: dictionary

# SQL 로그: 실제 실행 SQL에 파라미터 값을 채워 정렬해 보여준다 (P6Spy, 형식은 P6SpySqlFormatter).
decorator:
  datasource:
    enabled: true

logging:
  level:
    # P6Spy가 남기는 SQL 로그 (INFO)
    p6spy: info

app:
  jwt:
    # 로컬 개발 전용 HS256 키. UTF-8 32바이트 이상이어야 기동한다. 운영 키와 다르게 임의의 긴 문자열로 바꾼다.
    secret: change-me-local-development-jwt-secret-0123456789
  initial-admin:
    # 로컬 DB에 사용자가 한 명도 없을 때 admin 계정을 이 비밀번호로 만든다. 8~64자, 공백 없는 ASCII.
    password: change-me-admin-password
